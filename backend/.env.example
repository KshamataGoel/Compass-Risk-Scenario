# Copy to backend/.env and fill in. Never commit real credentials.

# --- Groq (used ONLY for management commentary generation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Corporate TLS interception (SSL: CERTIFICATE_VERIFY_FAILED)?
# Preferred: point to your organisation's root CA bundle:
# GROQ_CA_BUNDLE=C:\path\to\corporate-root-ca.pem
# POC-only fallback (skips verification): GROQ_VERIFY_SSL=false

# --- Data source (defaults to ../Database/Market_Risk_Case2_2Week_History_Database.xlsx) ---
# EXCEL_WORKBOOK_PATH=C:\path\to\Market_Risk_Case2_2Week_History_Database.xlsx

# --- CORS: comma-separated frontend origins ---
FRONTEND_ORIGINS=http://localhost:3000
